{
  "manifest_version": 2,
  "name": "Thunderbird RAG Search",
  "version": "1.1.0",
  "description": "Indexation et recherche RAG pour Thunderbird avec IndexedDB et LLM (Mistral/Ollama)",
  "applications": {
    "gecko": {
      "id": "rag-search@thunderbird",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesModify",
    "storage",
    "notifications",
    "downloads"
  ],
  "browser_action": {
    "default_panel": "src/modules/ui/sidebar.html",
    "default_title": "RAG Search",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg",
      "64": "icons/icon-64.svg"
    }
  },
  "options_ui": {
    "page": "src/modules/ui/options.html",
    "open_in_tab": true,
    "browser_style": true
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "64": "icons/icon-64.svg"
  },
  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.thunderbird.net/*"],
      "js": ["src/content.js"]
    }
  ]
}
